; Engine configuration file.
; LEVERAGE - Cinder City crime-action drama.
; Target: Godot 4.7 (mobile renderer). Built with API subset compatible with
; Godot 4.4 for XOGOT runtime compatibility. See docs/technical_architecture.md

config_version=5

[application]

config/name="LEVERAGE"
config/description="Everyone has leverage on you. A third-person open-world crime-action drama set in Cinder City."
config/version="2.5.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.4", "Mobile")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameState="*res://scripts/core/game_state.gd"
SaveSystem="*res://scripts/core/save_system.gd"
InputRouter="*res://scripts/core/input_router.gd"
AudioSystem="*res://scripts/core/audio_system.gd"
TimeWeather="*res://scripts/world/time_weather.gd"
WorldEvents="*res://scripts/world/world_events.gd"
StreetEncounters="*res://scripts/world/street_encounters.gd"
CityDirector="*res://scripts/world/city_director.gd"
NPCDirector="*res://scripts/npc/npc_director.gd"
PoliceSystem="*res://scripts/police/police_system.gd"
MissionSystem="*res://scripts/story/mission_system.gd"
DialogueSystem="*res://scripts/story/dialogue_system.gd"
GameManager="*res://scripts/core/game_manager.gd"

[display]

window/size/viewport_width=2688
window/size/viewport_height=1242
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

